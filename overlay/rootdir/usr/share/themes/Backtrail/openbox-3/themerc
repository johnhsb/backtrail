# Backtrail Openbox theme: flat navy title bars with contour-cyan accents.
# Uses Openbox's built-in button shapes.

border.width: 1
padding.width: 8
padding.height: 5
window.handle.width: 0
window.client.padding.width: 0
window.client.padding.height: 0

window.active.border.color: #0E2A47
window.inactive.border.color: #21405F
window.active.client.color: #0E2A47
window.inactive.client.color: #1B3552

window.active.title.bg: flat solid
window.active.title.bg.color: #0E2A47
window.active.title.separator.color: #0E2A47
window.inactive.title.bg: flat solid
window.inactive.title.bg.color: #1B3552
window.inactive.title.separator.color: #1B3552

window.active.label.bg: parentrelative
window.active.label.text.color: #E4EEF4
window.inactive.label.bg: parentrelative
window.inactive.label.text.color: #8FA7BB
window.label.text.justify: left

window.active.handle.bg: flat solid
window.active.handle.bg.color: #0E2A47
window.active.grip.bg: flat solid
window.active.grip.bg.color: #0E2A47
window.inactive.handle.bg: flat solid
window.inactive.handle.bg.color: #1B3552
window.inactive.grip.bg: flat solid
window.inactive.grip.bg.color: #1B3552

window.active.button.unpressed.bg: parentrelative
window.active.button.unpressed.image.color: #E4EEF4
window.active.button.hover.bg: flat solid
window.active.button.hover.bg.color: #16304C
window.active.button.hover.image.color: #3CC4D9
window.active.button.pressed.bg: flat solid
window.active.button.pressed.bg.color: #3CC4D9
window.active.button.pressed.image.color: #0E2A47
window.active.button.disabled.bg: parentrelative
window.active.button.disabled.image.color: #52677A
window.active.button.toggled.unpressed.bg: parentrelative
window.active.button.toggled.unpressed.image.color: #3CC4D9
window.active.button.toggled.hover.bg: flat solid
window.active.button.toggled.hover.bg.color: #16304C
window.active.button.toggled.hover.image.color: #3CC4D9
window.active.button.toggled.pressed.bg: flat solid
window.active.button.toggled.pressed.bg.color: #3CC4D9
window.active.button.toggled.pressed.image.color: #0E2A47

window.inactive.button.unpressed.bg: parentrelative
window.inactive.button.unpressed.image.color: #8FA7BB
window.inactive.button.hover.bg: flat solid
window.inactive.button.hover.bg.color: #21405F
window.inactive.button.hover.image.color: #E4EEF4
window.inactive.button.pressed.bg: flat solid
window.inactive.button.pressed.bg.color: #3CC4D9
window.inactive.button.pressed.image.color: #0E2A47
window.inactive.button.disabled.bg: parentrelative
window.inactive.button.disabled.image.color: #52677A
window.inactive.button.toggled.unpressed.bg: parentrelative
window.inactive.button.toggled.unpressed.image.color: #8FA7BB
window.inactive.button.toggled.hover.bg: flat solid
window.inactive.button.toggled.hover.bg.color: #21405F
window.inactive.button.toggled.hover.image.color: #E4EEF4
window.inactive.button.toggled.pressed.bg: flat solid
window.inactive.button.toggled.pressed.bg.color: #3CC4D9
window.inactive.button.toggled.pressed.image.color: #0E2A47

menu.border.width: 1
menu.border.color: #21405F
menu.overlap.x: 0
menu.overlap.y: 0
menu.items.bg: flat solid
menu.items.bg.color: #10233A
menu.items.text.color: #E4EEF4
menu.items.disabled.text.color: #52677A
menu.items.active.bg: flat solid
menu.items.active.bg.color: #3CC4D9
menu.items.active.text.color: #0E2A47
menu.items.active.disabled.text.color: #52677A
menu.title.bg: flat solid
menu.title.bg.color: #0E2A47
menu.title.text.color: #3CC4D9
menu.title.text.justify: left
menu.separator.color: #21405F
menu.separator.width: 1
menu.separator.padding.width: 8
menu.separator.padding.height: 3

osd.border.width: 1
osd.border.color: #21405F
osd.bg: flat solid
osd.bg.color: #10233A
osd.label.bg: parentrelative
osd.label.text.color: #E4EEF4
osd.hilight.bg: flat solid
osd.hilight.bg.color: #3CC4D9
osd.unhilight.bg: flat solid
osd.unhilight.bg.color: #21405F
